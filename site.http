<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AΦA Jeopardy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Libre+Franklin:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --maroon:#3e3e3c;
    --maroon-deep:#201f1f;
    --gold:#cfb35b;
    --old-gold:#cfb35b;
    --ink:#201f1f;
    --cream:#d9d9d9;
    --cell:#2b2b29;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(circle at 20% 0%, rgba(255,198,39,0.08), transparent 45%),
      linear-gradient(180deg, var(--maroon-deep), var(--ink) 70%);
    font-family:'Libre Franklin', sans-serif;
    color:var(--cream);
    padding:28px 16px 60px;
  }
  header{
    text-align:center;
    margin-bottom:22px;
  }
  header .kicker{
    letter-spacing:0.14em;
    font-size:12px;
    color:var(--old-gold);
    text-transform:uppercase;
  }
  h1{
    font-family:'Bebas Neue', sans-serif;
    font-size:clamp(38px, 7vw, 64px);
    letter-spacing:0.03em;
    margin:4px 0 6px;
    color:var(--gold);
    text-shadow:0 3px 0 rgba(0,0,0,0.4);
  }
  .subtitle{
    color:var(--cream);
    opacity:0.75;
    font-size:14px;
    max-width:560px;
    margin:0 auto;
  }
  #scoreboard{
    max-width:900px;
    margin:18px auto 26px;
    display:flex;
    justify-content:center;
    gap:14px;
    flex-wrap:wrap;
  }
  .team{
    background:rgba(0,0,0,0.35);
    border:1px solid rgba(198,161,91,0.4);
    border-radius:10px;
    padding:8px 14px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .team input[type=text]{
    background:transparent;
    border:none;
    border-bottom:1px solid var(--old-gold);
    color:var(--cream);
    font-family:'Libre Franklin';
    font-weight:600;
    font-size:14px;
    width:110px;
    padding:2px 0;
  }
  .team .score{
    font-family:'Bebas Neue';
    font-size:22px;
    color:var(--gold);
    min-width:46px;
    text-align:center;
  }
  .team button{
    background:none;
    border:1px solid var(--old-gold);
    color:var(--cream);
    border-radius:6px;
    width:24px;height:24px;
    cursor:pointer;
    font-size:14px;
    line-height:1;
  }
  .team button:hover{background:rgba(255,198,39,0.15);}

  #board{
    max-width:1100px;
    margin:0 auto;
    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:6px;
  }
  .cat{
    background:var(--maroon);
    color:var(--gold);
    font-family:'Bebas Neue';
    letter-spacing:0.02em;
    font-size:clamp(14px,2.1vw,20px);
    text-align:center;
    padding:14px 6px;
    border-radius:6px;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:64px;
    line-height:1.05;
    border:1px solid rgba(255,198,39,0.25);
  }
  .cell{
    background:var(--cell);
    color:var(--gold);
    font-family:'Bebas Neue';
    font-size:clamp(20px,3vw,30px);
    text-align:center;
    padding:20px 6px;
    border-radius:6px;
    cursor:pointer;
    border:1px solid rgba(198,161,91,0.25);
    transition:transform .12s ease, background .12s ease;
  }
  .cell:hover{background:#3a1424; transform:translateY(-2px);}
  .cell.used{
    background:rgba(255,255,255,0.03);
    color:rgba(255,198,39,0.18);
    cursor:default;
    box-shadow:none;
  }
  .cell.used:hover{transform:none; background:rgba(255,255,255,0.03);}

  #overlay{
    position:fixed;inset:0;
    background:rgba(0,0,0,0.72);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:10;
  }
  #overlay.show{display:flex;}
  #modal{
    background:linear-gradient(180deg, var(--maroon), var(--maroon-deep));
    border:2px solid var(--gold);
    border-radius:16px;
    max-width:640px;
    width:100%;
    padding:36px 32px;
    text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,0.5);
  }
  #modal .cat-label{
    color:var(--old-gold);
    font-family:'Bebas Neue';
    letter-spacing:0.08em;
    font-size:15px;
    margin-bottom:14px;
    text-transform:uppercase;
  }
  #modal .clue{
    font-size:clamp(19px,3.4vw,26px);
    line-height:1.4;
    color:var(--cream);
    min-height:80px;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  #modal .answer{
    margin-top:18px;
    font-family:'Bebas Neue';
    font-size:clamp(24px,4vw,32px);
    color:var(--gold);
    display:none;
  }
  #modal .answer.show{display:block;}
  #modal .btn-row{
    margin-top:26px;
    display:flex;
    gap:10px;
    justify-content:center;
    flex-wrap:wrap;
  }
  #modal button{
    font-family:'Libre Franklin';
    font-weight:700;
    font-size:14px;
    padding:10px 18px;
    border-radius:8px;
    border:1px solid var(--gold);
    background:transparent;
    color:var(--gold);
    cursor:pointer;
  }
  #modal button.primary{
    background:var(--gold);
    color:var(--maroon-deep);
  }
  #modal button:hover{opacity:0.85;}
  #modal .award{
    margin-top:20px;
    font-size:13px;
    color:var(--cream);
    opacity:0.8;
  }
</style>
</head>
<body>

<header>
  <h1>A&Phi;A Jeopardy</h1>
  <p class="subtitle">ASU facts, resume know-how, mystery majors, Alpha Phi Alpha history, and career networking &mdash; test the chapter!</p>
</header>

<div id="scoreboard"></div>

<div id="board"></div>

<div id="overlay">
  <div id="modal">
    <div class="cat-label" id="modalCat"></div>
    <div class="clue" id="modalClue"></div>
    <div class="answer" id="modalAnswer"></div>
    <div class="award" id="modalAward"></div>
    <div class="btn-row" id="modalButtons"></div>
  </div>
</div>

<script>
const categories = [
  {
    name: "ASU Facts",
    clues: [
      { value: 100, clue: "Arizona State University was founded in this year.", answer: "1885" },
      { value: 200, clue: "This is the name of ASU's Sun Devil mascot.", answer: "Sparky" },
      { value: 300, clue: "This is the Valley of the Sun city where ASU's original campus is located.", answer: "Tempe, Arizona" },
      { value: 400, clue: "This ASU president, in office since 2002, is known for building the 'New American University' model.", answer: "Michael Crow" },
      { value: 500, clue: "As of the 2025 U.S. News rankings, ASU has been named the nation's most innovative school for this many consecutive years.", answer: "11 years" }
    ]
  },
  {
    name: "Resume Related Questions",
    clues: [
      { value: 100, clue: "This is the ideal resume length for a student or someone with under 10 years of experience.", answer: "One page" },
      { value: 200, clue: "This resume section lists your degree(s), school(s), and graduation date(s).", answer: "The Education section" },
      { value: 300, clue: "Strong resume bullet points should start with these types of words instead of phrases like 'responsible for.'", answer: "Action verbs" },
      { value: 400, clue: "This acronym refers to the software many companies use to automatically scan resumes for keywords before a human sees them.", answer: "ATS (Applicant Tracking System)" },
      { value: 500, clue: "This is the term for adjusting your resume's skills and keywords to match a specific job posting.", answer: "Tailoring (customizing) your resume" }
    ]
  },
  {
    name: "What Is The Major",
    clues: [
      { value: 100, clue: "This major focuses on designing and building bridges, roads, and structures.", answer: "Civil Engineering" },
      { value: 200, clue: "This major studies the human mind and behavior.", answer: "Psychology" },
      { value: 300, clue: "This major covers writing, editing, and reporting the news.", answer: "Journalism" },
      { value: 400, clue: "This major focuses on financial markets, investments, and corporate money management.", answer: "Finance" },
      { value: 500, clue: "This major blends biology and computer science to analyze genetic and health data.", answer: "Bioinformatics" }
    ]
  },
  {
    name: "Alpha Phi Alpha Facts",
    clues: [
      { value: 100, clue: "Alpha Phi Alpha Fraternity, Inc. was founded in this year.", answer: "1906" },
      { value: 200, clue: "This university is where Alpha Phi Alpha was founded on December 4, 1906.", answer: "Cornell University" },
      { value: 300, clue: "These are Alpha Phi Alpha's official fraternity colors.", answer: "Black and Old Gold" },
      { value: 400, clue: "This is the term used for the seven founders of Alpha Phi Alpha.", answer: "The (Seven) Jewels" },
      { value: 500, clue: "This ancient Egyptian symbol represents Alpha Phi Alpha.", answer: "The Sphinx (Great Sphinx of Giza)" }
    ]
  },
  {
    name: "Networking & Career Tips",
    clues: [
      { value: 100, clue: "This professional platform is the most widely used site for networking and job searching.", answer: "LinkedIn" },
      { value: 200, clue: "You should send this within 24 hours after a job interview to leave a good impression.", answer: "A thank-you email/note" },
      { value: 300, clue: "This is the general term for building professional relationships that offer mutual career benefit.", answer: "Networking" },
      { value: 400, clue: "At a career fair, you should always bring several printed copies of this document.", answer: "Your resume" },
      { value: 500, clue: "This short, memorable self-introduction covers who you are, what you do, and what you're looking for in about 30 seconds.", answer: "An elevator pitch" }
    ]
  }
];

const board = document.getElementById("board");
const overlay = document.getElementById("overlay");
const modalCat = document.getElementById("modalCat");
const modalClue = document.getElementById("modalClue");
const modalAnswer = document.getElementById("modalAnswer");
const modalButtons = document.getElementById("modalButtons");
const modalAward = document.getElementById("modalAward");
const scoreboard = document.getElementById("scoreboard");

let teams = [
  { name: "Team 1", score: 0 },
  { name: "Team 2", score: 0 }
];

function renderScoreboard(){
  scoreboard.innerHTML = "";
  teams.forEach((t, i) => {
    const div = document.createElement("div");
    div.className = "team";
    div.innerHTML = `
      <input type="text" value="${t.name}" data-i="${i}" class="team-name">
      <span class="score" id="score-${i}">${t.score}</span>
      <button data-i="${i}" data-delta="-100" title="Subtract 100">&minus;</button>
      <button data-i="${i}" data-delta="100" title="Add 100">&plus;</button>
    `;
    scoreboard.appendChild(div);
  });
  scoreboard.querySelectorAll(".team-name").forEach(input => {
    input.addEventListener("change", e => {
      teams[e.target.dataset.i].name = e.target.value || teams[e.target.dataset.i].name;
    });
  });
  scoreboard.querySelectorAll("button").forEach(btn => {
    btn.addEventListener("click", e => {
      const i = e.target.dataset.i;
      teams[i].score += parseInt(e.target.dataset.delta, 10);
      document.getElementById(`score-${i}`).textContent = teams[i].score;
    });
  });
}
renderScoreboard();

function renderBoard(){
  board.innerHTML = "";
  categories.forEach(cat => {
    const catEl = document.createElement("div");
    catEl.className = "cat";
    catEl.textContent = cat.name;
    board.appendChild(catEl);
  });
  for(let row=0; row<5; row++){
    categories.forEach((cat, colIndex) => {
      const clue = cat.clues[row];
      const cell = document.createElement("div");
      cell.className = "cell";
      cell.textContent = "$" + clue.value;
      cell.dataset.cat = colIndex;
      cell.dataset.row = row;
      if(clue.used) cell.classList.add("used"), cell.textContent = "";
      cell.addEventListener("click", () => openClue(colIndex, row, cell));
      board.appendChild(cell);
    });
  }
}
renderBoard();

function openClue(catIndex, row, cellEl){
  const cat = categories[catIndex];
  const clue = cat.clues[row];
  if(clue.used) return;

  modalCat.textContent = cat.name + " — $" + clue.value;
  modalClue.textContent = clue.clue;
  modalAnswer.textContent = clue.answer;
  modalAnswer.classList.remove("show");
  modalAward.textContent = "";
  overlay.classList.add("show");

  modalButtons.innerHTML = "";
  const revealBtn = document.createElement("button");
  revealBtn.textContent = "Reveal Answer";
  revealBtn.className = "primary";
  revealBtn.onclick = () => {
    modalAnswer.classList.add("show");
    modalAward.textContent = "Award " + clue.value + " points to the team that got it right.";
    modalButtons.innerHTML = "";
    teams.forEach((t, i) => {
      const b = document.createElement("button");
      b.textContent = "✓ " + t.name;
      b.onclick = () => {
        teams[i].score += clue.value;
        document.getElementById(`score-${i}`).textContent = teams[i].score;
        closeClue();
      };
      modalButtons.appendChild(b);
    });
    const skip = document.createElement("button");
    skip.textContent = "No one got it";
    skip.onclick = closeClue;
    modalButtons.appendChild(skip);
  };

  const closeBtn = document.createElement("button");
  closeBtn.textContent = "Close";
  closeBtn.onclick = closeClue;

  modalButtons.appendChild(revealBtn);
  modalButtons.appendChild(closeBtn);

  overlay.dataset.cat = catIndex;
  overlay.dataset.row = row;
}

function closeClue(){
  const catIndex = overlay.dataset.cat;
  const row = overlay.dataset.row;
  if(catIndex !== undefined && row !== undefined){
    categories[catIndex].clues[row].used = true;
  }
  overlay.classList.remove("show");
  renderBoard();
}

overlay.addEventListener("click", (e) => {
  if(e.target === overlay) closeClue();
});
</script>

</body>
</html>
